{
  "name": "bhived",
  "version": "1.2.0",
  "description": "Open-source Bhived setup CLI for browser authentication and MCP client installation.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./global-instructions": {
      "types": "./dist/globalInstructions.d.ts",
      "default": "./dist/globalInstructions.js"
    },
    "./install-global-instructions": {
      "types": "./dist/installGlobalInstructions.d.ts",
      "default": "./dist/installGlobalInstructions.js"
    },
    "./agent-configs": {
      "types": "./dist/agentConfigs.d.ts",
      "default": "./dist/agentConfigs.js"
    },
    "./subscription": {
      "types": "./dist/subscription.d.ts",
      "default": "./dist/subscription.js"
    }
  },
  "bin": {
    "bhived": "dist/index.js"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "open": "^10.2.0",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bhived",
    "mcp",
    "setup",
    "cli",
    "model-context-protocol",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ArtKeyAi/bhived-mcp.git",
    "directory": "packages/bhived"
  },
  "homepage": "https://github.com/ArtKeyAi/bhived-mcp#readme",
  "bugs": {
    "url": "https://github.com/ArtKeyAi/bhived-mcp/issues"
  },
  "author": "ArtKey",
  "license": "Apache-2.0"
}
